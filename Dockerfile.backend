FROM node:20-alpine

WORKDIR /app

COPY backend/package*.json ./

RUN npm install

COPY backend/. .

RUN apk add --no-cache curl

COPY docker/scripts/startup.sh /startup.sh

RUN chmod +x /startup.sh

RUN addgroup -S app && adduser -S app -G app

USER app

EXPOSE 5000

ENTRYPOINT ["/startup.sh"]

CMD ["node", "server.js"]